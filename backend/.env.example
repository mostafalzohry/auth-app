NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/auth_app
JWT_SECRET=CHANGE_ME

# Required. Comma-separated exact browser origins allowed to call /api/auth (no paths, no wildcards; https only in production).
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Required in production only (ignored elsewhere): number of trusted reverse-proxy hops in front of the app. Verify it for your host.
# TRUST_PROXY_HOPS=1
